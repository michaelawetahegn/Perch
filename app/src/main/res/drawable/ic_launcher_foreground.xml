<?xml version="1.0" encoding="utf-8"?>
<!--
  The Perch mark (U09b): two stacked sheets, a serif P, rule lines, one amber block.

  Every path here is a verbatim copy of a constant in `ui/theme/Brand.kt` — a
  VectorDrawable cannot read a Kotlin string, so `LauncherIconTest` asserts the two
  copies still agree rather than trusting them to.

  All ink sits inside the centre 66dp circle (centre 54,54 · radius 33), which is the
  only part of a 108dp adaptive-icon layer every launcher mask is guaranteed to show.
  The same test measures that and fails the build if an edit pushes past it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The sheet behind, showing only as a sliver down the right edge. -->
    <path
        android:fillColor="@color/perch_mark_paper"
        android:strokeColor="@color/perch_mark_ink"
        android:strokeWidth="3.2"
        android:strokeLineJoin="round"
        android:pathData="M70,39 H73 A3,3 0 0 1 76,42 V69 A3,3 0 0 1 73,72 H70" />

    <!-- The sheet in front, which carries everything else. -->
    <path
        android:fillColor="@color/perch_mark_paper"
        android:strokeColor="@color/perch_mark_ink"
        android:strokeWidth="3.2"
        android:strokeLineJoin="round"
        android:pathData="M35,32 H67 A3,3 0 0 1 70,35 V73 A3,3 0 0 1 67,76 H35 A3,3 0 0 1 32,73 V35 A3,3 0 0 1 35,32 Z" />

    <!-- The serif P: outer silhouette, counter wound the other way, foot serif, top flag. -->
    <path
        android:fillColor="@color/perch_mark_ink"
        android:pathData="M36,36 H42.5 A6.5,6.5 0 0 1 42.5,49 H40.5 V53.5 H36 Z M40.5,46.4 H42.5 A3.9,3.9 0 0 0 42.5,38.6 H40.5 Z M34.5,51.9 H42 V53.5 H34.5 Z M34.9,36 H40.5 V37.6 H34.9 Z" />

    <!-- Headline rules. -->
    <path
        android:strokeColor="@color/perch_mark_ink"
        android:strokeWidth="2.6"
        android:pathData="M52,40 H65 M52,45 H65 M52,50 H65" />

    <!-- The heavier rule dividing headline from body. -->
    <path
        android:strokeColor="@color/perch_mark_ink"
        android:strokeWidth="3.2"
        android:pathData="M37,56.5 H65" />

    <!-- The mark's one accent. -->
    <path
        android:fillColor="@color/perch_mark_accent"
        android:strokeColor="@color/perch_mark_ink"
        android:strokeWidth="2"
        android:pathData="M37,60 H48.5 V71.5 H37 Z" />

    <!-- Body rules. -->
    <path
        android:strokeColor="@color/perch_mark_ink"
        android:strokeWidth="2.6"
        android:pathData="M52,62 H65 M52,66 H65 M52,70 H65" />
</vector>
