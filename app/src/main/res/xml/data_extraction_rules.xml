<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ (android:dataExtractionRules). The API 26–30 equivalent is
  backup_rules.xml; both must stay in sync.

  Same two payloads, declared twice because the two transfer paths are separate
  policies: cloud-backup goes to Google's servers, device-transfer is a direct
  phone-to-phone copy. Perch's data is a reading history, so both are fine — but
  they are stated explicitly rather than inherited.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="perch.db" />
        <include domain="database" path="perch.db-wal" />
        <include domain="database" path="perch.db-shm" />
        <include domain="file" path="datastore/perch-settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="perch.db" />
        <include domain="database" path="perch.db-wal" />
        <include domain="database" path="perch.db-shm" />
        <include domain="file" path="datastore/perch-settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
